{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "strict": true,
    "skipLibCheck": true,
    "strictPropertyInitialization": false,
    "noImplicitAny": true,
    "paths": {
      "@app/common": [
        "../../packages/common/src"
      ],
      "@app/common/*": [
        "../../packages/common/src/*"
      ],
      "@app/redis": [
        "../../packages/redis/src"
      ],
      "@app/redis/*": [
        "../../packages/redis/src/*"
      ]
    }
  }
}
